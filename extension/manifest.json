{
  "manifest_version": 3,
  "name": "PumpkinEater",
  "description": "Scans the current page for question boxes and answers them with Claude.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Answer the questions on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "options_page": "options/options.html",
  "commands": {
    "answer-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Scan this page and answer its questions"
    }
  }
}
